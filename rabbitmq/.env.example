# Copiar a .env en la EC2 C y reemplazar los valores. El archivo .env NO se sube al repositorio.

# Administrador del broker (solo para la interfaz web y la configuración)
RABBITMQ_ADMIN_USER=mesatech_admin
RABBITMQ_ADMIN_PASSWORD=CAMBIAR_password_admin

# Usuarios de aplicación (los usa setup-rabbitmq.sh)
RABBITMQ_PUBLICADOR_USER=mesatech_publicador
RABBITMQ_PUBLICADOR_PASSWORD=CAMBIAR_password_publicador
RABBITMQ_CONSUMIDOR_USER=mesatech_consumidor
RABBITMQ_CONSUMIDOR_PASSWORD=CAMBIAR_password_consumidor
